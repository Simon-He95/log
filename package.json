{
  "publisher": "simonhe",
  "name": "log",
  "displayName": "log",
  "version": "0.1.4",
  "description": "🚀 The ultimate console.log management extension - Smart insertion, beautiful colors, and powerful cleanup tools for JavaScript/TypeScript developers",
  "author": "Simon He <https://github.com/Simon-He95>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/Simon-He95",
  "homepage": "https://github.com/Simon-He95/log#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Simon-He95/log"
  },
  "bugs": {
    "url": "https://github.com/Simon-He95/log/issues"
  },
  "sponsor": {
    "url": "https://github.com/Simon-He95/sponsor"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/index.cjs",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.77.0"
  },
  "activationEvents": [
    "onCommand:log.log",
    "onCommand:log.removeConsoleLogs",
    "onCommand:log.removeConsoleLogsWorkspace",
    "onCommand:log.previewRemoveConsoleLogs"
  ],
  "contributes": {
    "commands": [
      {
        "command": "log.log",
        "title": "🚀 Insert Smart Console.log",
        "category": "Log"
      },
      {
        "command": "log.removeConsoleLogs",
        "title": "🧹 Remove Console Logs (Current File)",
        "category": "Log"
      },
      {
        "command": "log.removeConsoleLogsWorkspace",
        "title": "🌍 Remove Console Logs (Workspace)",
        "category": "Log"
      },
      {
        "command": "log.previewRemoveConsoleLogs",
        "title": "👁️ Preview Console Log Removal",
        "category": "Log"
      }
    ],
    "keybindings": [
      {
        "command": "log.log",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus && !editorReadonly && (editorLangId == 'javascript' || editorLangId == 'typescript' || editorLangId == 'javascriptreact' || editorLangId == 'typescriptreact' || editorLangId == 'vue')"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "log",
      "properties": {
        "codeLoc.config": {
          "type": "object",
          "default": {
            "fileInfo": true,
            "scoped": true,
            "randomColor": true
          },
          "description": "Insertion behavior config (legacy key)"
        },
        "log.removeConsole": {
          "type": "object",
          "default": {
            "methods": [
              "log",
              "warn",
              "error",
              "info",
              "debug"
            ],
            "preservePatterns": [
              "TODO",
              "KEEP"
            ],
            "includeTrailingNewLine": true
          },
          "description": "Remove console.* configuration: methods to target, patterns to preserve if found inside args, and whether to remove the trailing newline if the whole line only contained the call."
        },
        "log.removeConsole.workspace": {
          "type": "object",
          "default": {
            "includeGlobs": [
              "**/*.{js,jsx,ts,tsx}"
            ],
            "excludeGlobs": [
              "**/node_modules/**",
              "**/dist/**"
            ],
            "confirm": true
          },
          "description": "Workspace removal options: include / exclude globs and confirmation toggle."
        },
        "codeLoc.config.colors": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Optional fixed color list for log styling; overrides randomColor when non-empty."
        }
      }
    }
  },
  "scripts": {
    "dev": "pnpm build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsdown src/index.ts --external vscode --format cjs",
    "pack": "vsce package --no-dependencies",
    "lint": "eslint --cache",
    "lint:fix": "pnpm lint --fix",
    "publish": "vsce publish --no-dependencies",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && pnpm run publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@types/vscode": "1.77.0",
    "@vscode-use/utils": "^0.1.62",
    "@vscode/vsce": "^3.9.2",
    "bumpp": "^9.11.1",
    "eslint": "^8.57.1",
    "tsdown": "^0.18.4",
    "typescript": "^5.9.3",
    "vitest": "^0.29.8"
  },
  "keywords": [
    "vscode",
    "extension",
    "console.log",
    "logging",
    "developer tools",
    "productivity",
    "javascript",
    "typescript",
    "debugging",
    "console management",
    "log insertion",
    "code cleanup",
    "smart logging",
    "multi-line expressions",
    "ast parsing",
    "workspace cleanup",
    "preview mode",
    "colored output",
    "variable detection",
    "development workflow"
  ],
  "packageManager": "pnpm@10.34.4+sha512.8768be55200ae3f2226b6527fcca2687e14bc4e5f12d7721a0f25da3df47915177058648db4177baf348120fa0ba2752d8d8d93f6beaf1fe64ae18da8de961af"
}
